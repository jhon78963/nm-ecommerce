# =============================================================================
# .env.example — nm-ecommerce
# Copia a .env.local y completa los valores.
#
# Dominios producción:
#   Tienda: https://novedadesmaritex.net.pe
#   API:    https://api.novedadesmaritex.net.pe
# =============================================================================

# API pública (gateway NestJS — solo server-side)
API_BASE_URL=http://localhost:3000/api/v1
# Producción: https://api.novedadesmaritex.net.pe/api/v1

# Proxy server-side al ecommerce-service
ECOMMERCE_SERVICE_URL=http://localhost:3012

# Almacén del storefront (requerido para catálogo/home)
STORE_WAREHOUSE_ID=

# URL pública del storefront
NEXT_PUBLIC_APP_URL=http://localhost:3015
# Producción: https://novedadesmaritex.net.pe

# WhatsApp (solo dígitos con código de país)
NEXT_PUBLIC_WHATSAPP_NUMBER=51901259663

# Opcional
API_ACCESS_TOKEN=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
