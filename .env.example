# =============================================================================
# .env.example — nm-ecommerce
# Copia a .env.local y completa los valores.
#
# Dominios producción:
#   Tienda: https://novedadesmaritex.net.pe
#   API:    https://api.novedadesmaritex.net.pe
# =============================================================================

# API pública (gateway NestJS — solo server-side)
API_BASE_URL=http://localhost:3000/api/v1
# Producción: https://api.novedadesmaritex.net.pe/api/v1

# Proxy server-side al ecommerce-service
ECOMMERCE_SERVICE_URL=http://localhost:3012

# Almacén del storefront (requerido para catálogo/home)
STORE_WAREHOUSE_ID=

# URL pública del storefront
NEXT_PUBLIC_APP_URL=http://localhost:3015
# Producción: https://novedadesmaritex.net.pe

# WhatsApp (solo dígitos con código de país)
NEXT_PUBLIC_WHATSAPP_NUMBER=51921619616

# Pago manual Yape / Plin / transferencia (opcional)
# Imagen QR: coloca yape-qr.png en public/payments/ o usa una URL absoluta
# NEXT_PUBLIC_YAPE_QR_IMAGE_URL=/payments/yape-qr.png
# NEXT_PUBLIC_YAPE_PHONE=51921619616
# Nombre enmascarado del titular (como al escanear en Yape)
# NEXT_PUBLIC_YAPE_MERCHANT_NAME=Maria Cer*

# Opcional
API_ACCESS_TOKEN=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google reCAPTCHA v3 (https://www.google.com/recaptcha/admin)
# Registrar localhost y dominio de producción en la consola de Google.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Culqi Checkout (pública — Panel integración pk_test_ / producción pk_live_)
NEXT_PUBLIC_CULQI_PUBLIC_KEY=
# NEXT_PUBLIC_CULQI_LOGO_URL=https://novedadesmaritex.net.pe/logo.png

# API pública del gateway (CSP connect-src e imágenes remotas; opcional si difiere de API_BASE_URL)
# NEXT_PUBLIC_API_BASE_URL=https://api.novedadesmaritex.net.pe/api/v1

# ISR on-demand (POST /api/revalidate desde el backend o webhooks)
REVALIDATE_SECRET=

# Analytics opcionales (solo se cargan tras consentimiento de cookies)
# Preferir GTM y configurar GA4 dentro del contenedor. Si no usas GTM:
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_CF_BEACON_TOKEN=

# Sentry (errores cliente + servidor; vacío = desactivado)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=nm-ecommerce@0.1.0
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_AUTH_TOKEN=   # solo CI/deploy para subir source maps

# CSP: false = Report-Only incluso en producción (solo depuración)
# CSP_ENFORCE=true
